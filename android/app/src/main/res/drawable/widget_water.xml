<?xml version="1.0" encoding="utf-8"?>
<!-- Static "water" wave fill for the bottom half of the widget. Two layered
     wave paths in different cyans give a sense of depth without animation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="90dp"
    android:viewportWidth="240"
    android:viewportHeight="90">

    <!-- Lower, darker wave -->
    <path
        android:fillColor="#22D3EE"
        android:fillAlpha="0.85"
        android:pathData="M0,40 Q30,20 60,40 T120,40 T180,40 T240,40 L240,90 L0,90 Z" />

    <!-- Upper, lighter wave with subtle offset for a "ripple" effect -->
    <path
        android:fillColor="#A5F3FC"
        android:fillAlpha="0.75"
        android:pathData="M0,50 Q30,38 60,50 T120,50 T180,50 T240,50 L240,90 L0,90 Z" />

    <!-- Bubbles -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M40,68 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4"
        android:pathData="M150,75 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M200,62 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
</vector>
