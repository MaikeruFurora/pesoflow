    android:viewportHeight="40">

    <!-- Coin shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M20,22 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />

    <!-- Outer rim (darker gold) -->
