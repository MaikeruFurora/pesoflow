        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M14,14 m-3,-2 a4,3 0 1,0 6,0 a4,3 0 1,0 -6,0" />

    <!-- Peso glyph -->
    <path
        android:fillColor="#8B6914"
        android:pathData="M16,13 L16,28 L18.5,28 L18.5,23 L22.5,23 Q26,23 26,20 Q26,17 22.5,17 L18.5,17 L18.5,15 L25,15 L25,13 Z M18.5,19 L22.5,19 Q23.5,19 23.5,20 Q23.5,21 22.5,21 L18.5,21 Z" />

