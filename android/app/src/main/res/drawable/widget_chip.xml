<?xml version="1.0" encoding="utf-8"?>
<!-- Stylised EMV chip — a gold rounded rect with darker contact lines suggested
     by an inner stroke. Pure XML so it survives all OEM widget hosts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F5C26B"
                android:centerColor="#E0A94C"
                android:endColor="#8B6914"
                android:type="linear" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#80000000" />
            <corners android:radius="3dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- horizontal divider line in the middle, giving that "chip contacts" look -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="9dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
        </shape>
    </item>
</layer-list>
